PORT=3001
MONGO_URI=mongodb://localhost:27017/password-manager
JWT_SECRET=cambiame_por_un_secreto_largo_y_random

# Origenes permitidos para CORS, separados por coma. Sin esto, el backend
# rechaza requests de navegador de cualquier origen que no este acá.
# Ejemplos: frontend en dev (Vite), frontend dockerizado en local, dominio real.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
